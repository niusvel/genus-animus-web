# Plantilla de variables de entorno del frontend.
#
# Vite selecciona el archivo según el modo:
#   - npm run dev   -> modo development -> .env.development
#   - vite build    -> modo production  -> .env.production (+ dashboard de Vercel)
#
# Solo las variables con prefijo VITE_ se exponen al cliente.

# URL base de la API (debe incluir el esquema http:// o https://)
VITE_API_URL=http://localhost:3000
